# Backend de Nexora — variables de ejemplo.
# Copiar a .env y sustituir los marcadores. No usar credenciales reales aquí.

# Desarrollo local (PostgreSQL 18, puerto 5433 en el equipo de referencia)
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@localhost:5433/nexora_dev

# Pruebas automatizadas (nunca la base de desarrollo)
TEST_DATABASE_URL=postgresql+psycopg://USER:PASSWORD@localhost:5433/nexora_test

FRONTEND_ORIGIN=http://localhost:3000

# Pendientes de decisión (no definir todavía):
# - SECRET_KEY o secreto equivalente, si la configuración de CSRF lo requiere (AT-04).
# - Variables del proveedor de correo electrónico (AT-05).
# - Configuración definitiva de CORS, SameSite y CSRF (AT-04).
